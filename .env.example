# ==========================================
# Frontend Environment Configuration Template
# ==========================================

# Base URL for the Backend API.
# 
# Options:
# 1. Local Development (Default):
#    Leave empty to let Vite's dev server proxy `/api` requests to http://127.0.0.1:3000
#    VITE_API_URL=
#
# 2. Local Development (Direct Cross-Origin):
#    VITE_API_URL=http://localhost:3000
#
# 3. Production Deployment (Azure Container Apps / Custom API domain):
#    VITE_API_URL=https://gamebacklog-backend.<region>.azurecontainerapps.io
#
VITE_API_URL=

# Application Display Name
VITE_APP_TITLE=NEXT.g — Game Backlog & Roulette
