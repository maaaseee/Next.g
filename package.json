{
  "name": "frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "docker:db": "docker compose up -d db",
    "docker:db:down": "docker compose stop db",
    "docker:db:logs": "docker compose logs -f db"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@formkit/auto-animate": "^0.10.2",
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "vue": "rc",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}
