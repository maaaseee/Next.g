# Port on which the Elysia backend server will listen
PORT=3000

# PostgreSQL Connection String (Format: postgres://user:password@host:port/dbname)
# Local Docker Postgres: postgres://postgres:postgrespassword@localhost:5432/nextg_db
# Supabase / Neon: postgres://[user]:[password]@[host]:5432/[db]?sslmode=require
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/nextg_db

# Twitch Developer / IGDB API Credentials
# 1. Sign in to https://dev.twitch.tv/console
# 2. Register an application (Name: NEXT.g, Category: Website/Application, OAuth Redirect: http://localhost)
# 3. Copy your Client ID and generate a Client Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Frontend URL allowed for CORS (Can be a single URL or comma-separated list of allowed URLs)
# Examples:
# CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173,https://gamebacklog.vercel.app,https://mycustomdomain.com
CORS_ORIGIN=http://localhost:5173

# Cloudinary Configuration for User Avatars
# Free tier: 25GB managed storage & bandwidth. Register at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gamebacklog-avatars

# Optional: Upstash Redis for Durable Distributed Rate Limiting (Protects across Scale-to-Zero)
# Free tier: 10,000 commands/day forever. Register at https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auto-seed initial catalog from IGDB API if the database is empty (true/false)
# Default is false (startup seeder is disabled; games are fetched on demand)
AUTO_SEED=false

# JWT Authentication Secret Key
JWT_SECRET=nextg-secret-jwt-key-2026-change-in-production

# Third-Party OAuth: Google
# Register at: https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Third-Party OAuth: GitHub
# Register at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URLs for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
