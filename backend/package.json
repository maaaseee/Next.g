{
  "name": "backend",
  "version": "1.1.0",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "seed": "bun run src/db/seed.ts",
    "migrate": "bun run src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "docker:db": "docker compose -f ../docker-compose.yml up -d db",
    "docker:db:down": "docker compose -f ../docker-compose.yml stop db"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "cloudinary": "^2.11.0",
    "elysia": "latest",
    "postgres": "^3.4.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "typescript": "^5.9.3"
  },
  "module": "src/index.ts"
}
